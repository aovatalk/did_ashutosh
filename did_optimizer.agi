#!/usr/bin/perl

# VICIdial DID Optimizer
# Runtime dependencies: Perl, DBI, DBD::mysql, Asterisk AGI, VICIdial database.

use strict;
use warnings;
use DBI;

$| = 1;

my $SCRIPT_NAME          = 'did_optimizer.agi';
my $CONFIG_FILE         = '/etc/astguiclient.conf';
my $DEBUG               = exists $ENV{'DIDOPT_DEBUG'} ? ($ENV{'DIDOPT_DEBUG'} ? 1 : 0) : 0;
my $DEADLOCK_MAX_ATTEMPTS = 4; # 1213 deadlock / 1205 lock wait timeout only.

my $dbh;
my $agi_ready = 0;

sub read_agi_environment {
    my %agi;
    while (defined(my $line = <STDIN>)) {
        $line =~ s/[\r\n]+$//;
        last if $line eq '';
        if ($line =~ /^agi_([^:]+):\s*(.*)$/) {
            $agi{$1} = $2;
        }
    }
    $agi_ready = 1;
    return \%agi;
}

sub agi_quote {
    my ($value) = @_;
    $value = '' unless defined $value;
    $value =~ s/[\r\n\x00-\x1f]+/ /g;
    $value =~ s/\\/\\\\/g;
    $value =~ s/"/\\"/g;
    return qq{"$value"};
}

sub agi_command {
    my ($command) = @_;
    return (undef, 'AGI environment not available') unless $agi_ready;

    print STDOUT $command . "\n";
    my $response = <STDIN>;
    return (undef, 'No response from Asterisk') unless defined $response;
    $response =~ s/[\r\n]+$//;

    if ($response =~ /^200\s+result=(-?\d+)/) {
        return ($1 + 0, $response);
    }
    return (undef, $response);
}

sub agi_verbose {
    my ($message, $always) = @_;
    return unless $always || $DEBUG;
    $message = 'DIDOPT: ' . ($message // '');
    agi_command('VERBOSE ' . agi_quote($message) . ' 1');
}

sub agi_set_variable {
    my ($name, $value) = @_;
    return 0 unless defined $name && $name =~ /^[A-Za-z0-9_()]+$/;
    my ($result) = agi_command('SET VARIABLE ' . $name . ' ' . agi_quote($value));
    return defined($result) && $result >= 0;
}

sub set_callerid {
    my ($did) = @_;
    return 0 unless defined $did && $did =~ /^\d{7,32}$/;
    # Set only CALLERID(num); do not overwrite CALLERID(name).
    my ($result) = agi_command('EXEC Set CALLERID(num)=' . $did);
    return defined($result) && $result >= 0;
}

sub set_failure_status {
    my ($status, $reason) = @_;
    agi_set_variable('DIDOPT_STATUS', $status);
    agi_set_variable('DIDOPT_REASON', $reason);
    agi_verbose("status=$status reason=$reason", 1);
}

sub abort_request {
    my ($status, $message) = @_;
    $message =~ s/[\r\n|]+/ /g;
    die "DIDOPT_ABORT|$status|$message\n";
}

sub load_vicidial_config {
    my ($path) = @_;
    open(my $fh, '<', $path) or die "Cannot open $path: $!";

    my %config;
    while (my $line = <$fh>) {
        $line =~ s/[\r\n]+$//;
        $line =~ s/^\s+|\s+$//g;
        next if $line eq '' || $line =~ /^\s*[#;]/;
        next unless $line =~ /^([A-Za-z0-9_]+)\s*=>?\s*(.*?)\s*$/;
        $config{$1} = $2;
    }
    close($fh);

    for my $required (qw(VARDB_server VARDB_database VARDB_user VARDB_pass)) {
        die "Missing $required in $path" unless defined $config{$required} && $config{$required} ne '';
    }
    $config{'VARDB_port'} = 3306 unless $config{'VARDB_port'};
    die 'Invalid VARDB_port' unless $config{'VARDB_port'} =~ /^\d{1,5}$/;
    return \%config;
}

sub connect_database {
    my ($config) = @_;
    my $dsn = 'DBI:mysql:database=' . $config->{'VARDB_database'}
            . ';host=' . $config->{'VARDB_server'}
            . ';port=' . $config->{'VARDB_port'};

    my $dbh = DBI->connect(
        $dsn,
        $config->{'VARDB_user'},
        $config->{'VARDB_pass'},
        {
            RaiseError           => 1,
            PrintError           => 0,
            AutoCommit           => 1,
            mysql_auto_reconnect => 0,
        }
    );
    # Align the connection collation with the existing VICIdial schema
    # (utf8_unicode_ci) so comparisons/joins against vicidial_* tables do not
    # raise "Illegal mix of collations".
    $dbh->do('SET NAMES utf8 COLLATE utf8_unicode_ci') if $dbh;
    return $dbh;
}

sub clean_argument {
    my ($value) = @_;
    return '' unless defined $value;
    $value =~ s/^\s+|\s+$//g;
    return '' if $value =~ /^(?:NULL|NONE|UNDEFINED)$/i;
    return $value;
}

sub normalize_number {
    my ($number) = @_;
    return '' unless defined $number;
    $number =~ s/\D//g;

    # Initial implementation is intentionally NANP-focused.
    if (length($number) == 10 && $number =~ /^[2-9]/) {
        return '1' . $number;
    }
    if (length($number) == 11 && $number =~ /^1[2-9]/) {
        return $number;
    }
    return $number;
}

sub get_npanxx {
    my ($number) = @_;
    my $normalized = normalize_number($number);
    return $1 if $normalized =~ /^1([2-9]\d{2}[2-9]\d{2})\d{4}$/;
    return '';
}

# VICIdial-version-specific live-call mapping is isolated here.
# This repository maps outbound calls through vicidial_auto_calls.
sub find_current_call {
    my ($db, $agi, $args, $local_server_ip) = @_;

    my $arg_campaign = clean_argument($args->[0]);
    my $arg_destination = clean_argument($args->[1]);
    my $arg_uniqueid = clean_argument($args->[2]);
    my $arg_lead_id = clean_argument($args->[3]);

    my $agi_uniqueid = clean_argument($agi->{'uniqueid'});
    my $agi_channel = clean_argument($agi->{'channel'});
    my $agi_callerid = clean_argument($agi->{'callerid'});
    my $agi_calleridname = clean_argument($agi->{'calleridname'});
    my $lookup_uniqueid = $arg_uniqueid || $agi_uniqueid;
    my $row;

    my $columns = q{
        SELECT auto_call_id, server_ip, campaign_id, lead_id, uniqueid, callerid,
               phone_code, phone_number, channel, call_type
          FROM vicidial_auto_calls
    };

    if ($lookup_uniqueid ne '') {
        $row = $db->selectrow_hashref(
            $columns . q{ WHERE uniqueid = ? AND server_ip = ? AND call_type IN ('OUT','OUTBALANCE')
                          ORDER BY auto_call_id DESC LIMIT 1},
            undef, $lookup_uniqueid, $local_server_ip
        );
    }
    if (!$row && $agi_channel ne '') {
        $row = $db->selectrow_hashref(
            $columns . q{ WHERE channel = ? AND server_ip = ? AND call_type IN ('OUT','OUTBALANCE')
                          ORDER BY auto_call_id DESC LIMIT 1},
            undef, $agi_channel, $local_server_ip
        );
    }
    if (!$row && ($agi_callerid ne '' || $agi_calleridname ne '')) {
        $row = $db->selectrow_hashref(
            $columns . q{ WHERE (callerid = ? OR callerid = ?) AND server_ip = ?
                          AND call_type IN ('OUT','OUTBALANCE')
                          ORDER BY auto_call_id DESC LIMIT 1},
            undef, $agi_callerid, $agi_calleridname, $local_server_ip
        );
    }

    $row ||= {};
    my $campaign = $arg_campaign || clean_argument($row->{'campaign_id'});
    my $destination = $arg_destination;
    if ($destination eq '') {
        $destination = clean_argument($row->{'phone_code'})
                     . clean_argument($row->{'phone_number'});
    }
    my $call_id = clean_argument($row->{'uniqueid'}) || $lookup_uniqueid;
    my $lead_id = ($arg_lead_id =~ /^\d+$/) ? $arg_lead_id : ($row->{'lead_id'} || undef);

    return {
        campaign_id   => $campaign,
        server_ip     => clean_argument($row->{'server_ip'}) || $local_server_ip,
        destination   => normalize_number($destination),
        unique_call_id => $call_id,
        lead_id       => $lead_id,
        auto_call_id  => $row->{'auto_call_id'},
        lookup_source => keys(%$row) ? 'vicidial_auto_calls' : 'dialplan_arguments',
    };
}

sub validate_call_context {
    my ($call) = @_;
    abort_request('NO_CAMPAIGN', 'Current outbound campaign could not be determined')
        unless $call->{'campaign_id'};
    abort_request('NO_CAMPAIGN', 'Campaign identifier contains unsupported characters')
        unless $call->{'campaign_id'} =~ /^[A-Za-z0-9_-]{1,20}$/;
    abort_request('NO_SERVER', 'Local VICIdial server identity could not be determined')
        unless $call->{'server_ip'} && length($call->{'server_ip'}) <= 45;
    abort_request('NO_DESTINATION', 'Outbound destination could not be determined')
        unless $call->{'destination'} && $call->{'destination'} =~ /^\d{7,32}$/;
    abort_request('NO_CALL', 'A correlation uniqueid could not be determined')
        unless $call->{'unique_call_id'};
    abort_request('NO_CALL', 'Correlation uniqueid is too long or contains control characters')
        if length($call->{'unique_call_id'}) > 64 || $call->{'unique_call_id'} =~ /[\x00-\x1f]/;
}

sub get_candidate_dids {
    my ($db, $campaign) = @_;
    # No reputation join here: admin_did_optimizer_pool.php and
    # reputation_cron.php already disable (enabled='N') any DID whose
    # reputation comes back negative, so p.enabled alone reflects it. A DID
    # an admin has manually re-enabled despite a still-negative cached
    # reputation is now eligible again immediately, rather than staying
    # excluded until its cache entry changes.
    my $sql = q{
        SELECT p.did_id, p.did_number, p.campaign_id,
               p.daily_limit, p.last_used,
               p.sample_size, p.human_answered_calls, p.good_calls,
               p.answered_seconds_sum, p.performance_score
          FROM did_optimizer_pool p
         WHERE p.campaign_id = ?
           AND p.enabled = 'Y'
           AND (p.daily_limit = 0 OR
                CASE WHEN p.usage_date = CURDATE() THEN p.calls_today ELSE 0 END < p.daily_limit)
         ORDER BY p.did_id
    };
    my $rows = $db->selectall_arrayref($sql, { Slice => {} }, $campaign);

    my @valid;
    for my $did (@$rows) {
        $did->{'did_number'} = normalize_number($did->{'did_number'});
        next unless $did->{'did_number'} =~ /^\d{7,32}$/;
        $did->{'npanxx'} = get_npanxx($did->{'did_number'});
        push @valid, $did;
    }
    return \@valid;
}

sub get_geo_profiles {
    my ($db, $numbers) = @_;
    my %prefixes = map { my $p = get_npanxx($_); $p ? ($p => 1) : () } @$numbers;
    my %npas = map { substr($_, 0, 3) => 1 } keys %prefixes;
    my %profiles;
    return \%profiles unless keys %prefixes;

    for my $prefix (keys %prefixes) {
        $profiles{$prefix} = {
            npanxx => $prefix, npa => substr($prefix, 0, 3),
            cities => {}, states => {}, countries => {},
        };
    }

    my @prefix_list = sort keys %prefixes;
    my $placeholders = join(',', ('?') x scalar(@prefix_list));
    my $rows = $db->selectall_arrayref(
        qq{SELECT npanxx, npa, LOWER(city) AS city, state_iso, country_iso
             FROM did_optimizer_geo_prefixes
            WHERE npanxx IN ($placeholders)},
        { Slice => {} }, @prefix_list
    );
    for my $row (@$rows) {
        my $profile = $profiles{$row->{'npanxx'}};
        my $country = uc($row->{'country_iso'} || '');
        my $state = uc($row->{'state_iso'} || '');
        my $city = lc($row->{'city'} || '');
        $profile->{'countries'}->{$country} = 1 if $country ne '';
        $profile->{'states'}->{"$country|$state"} = 1 if $state ne '';
        $profile->{'cities'}->{"$country|$state|$city"} = 1 if $city ne '';
    }

    # The source snapshot may not contain recently assigned exchanges. Enrich
    # every prefix with its NPA's state/country footprint so those numbers can
    # still participate in same-area-code and same-state matching.
    my @npa_list = sort keys %npas;
    my $npa_placeholders = join(',', ('?') x scalar(@npa_list));
    my $npa_rows = $db->selectall_arrayref(
        qq{SELECT DISTINCT npa, state_iso, country_iso
             FROM did_optimizer_geo_prefixes
            WHERE npa IN ($npa_placeholders)},
        { Slice => {} }, @npa_list
    );
    my %npa_geo;
    for my $row (@$npa_rows) {
        my $country = uc($row->{'country_iso'} || '');
        my $state = uc($row->{'state_iso'} || '');
        $npa_geo{$row->{'npa'}}->{'countries'}->{$country} = 1 if $country ne '';
        $npa_geo{$row->{'npa'}}->{'states'}->{"$country|$state"} = 1 if $state ne '';
    }
    # VICIdial ships an area-code geography table. It supplies a cluster-safe
    # baseline when the optional NPA-NXX enrichment table has not been loaded.
    my $vicidial_npa_rows = $db->selectall_arrayref(
        qq{SELECT CAST(areacode AS CHAR) AS npa,
                  UPPER(COALESCE(state, '')) AS state_iso,
                  UPPER(COALESCE(country, '')) AS country_iso
             FROM vicidial_phone_codes
            WHERE areacode IN ($npa_placeholders)},
        { Slice => {} }, @npa_list
    );
    for my $row (@$vicidial_npa_rows) {
        my $country = uc($row->{'country_iso'} || '');
        my $state = uc($row->{'state_iso'} || '');
        $npa_geo{$row->{'npa'}}->{'countries'}->{$country} = 1 if $country ne '';
        $npa_geo{$row->{'npa'}}->{'states'}->{"$country|$state"} = 1 if $state ne '';
    }
    for my $profile (values %profiles) {
        my $fallback = $npa_geo{$profile->{'npa'}} || {};
        @{$profile->{'countries'}}{keys %{$fallback->{'countries'} || {}}} = (1) x scalar(keys %{$fallback->{'countries'} || {}});
        @{$profile->{'states'}}{keys %{$fallback->{'states'} || {}}} = (1) x scalar(keys %{$fallback->{'states'} || {}});
    }
    return \%profiles;
}

sub geo_match_rank {
    my ($destination, $candidate) = @_;
    return 0 unless $destination && $candidate;
    return 4 if $destination->{'npanxx'} eq $candidate->{'npanxx'};
    for my $key (keys %{$candidate->{'cities'}}) {
        return 3 if $destination->{'cities'}->{$key};
    }
    if (($destination->{'npa'} || '') ne '' && $destination->{'npa'} eq ($candidate->{'npa'} || '')) {
        for my $country (keys %{$candidate->{'countries'}}) {
            return 2 if $destination->{'countries'}->{$country};
        }
    }
    for my $key (keys %{$candidate->{'states'}}) {
        return 1 if $destination->{'states'}->{$key};
    }
    return 0;
}

sub get_best_geo_pool {
    my ($candidates, $destination_profile, $geo_profiles) = @_;
    my $best_rank = 0;
    for my $candidate (@$candidates) {
        my $rank = geo_match_rank($destination_profile, $geo_profiles->{$candidate->{'npanxx'}});
        $candidate->{'geo_match_rank'} = $rank;
        $best_rank = $rank if $rank > $best_rank;
    }
    my @pool = $best_rank
        ? grep { ($_->{'geo_match_rank'} || 0) == $best_rank } @$candidates
        : @$candidates;
    return (\@pool, $best_rank);
}

# Atomically reserves the best-scoring eligible DID from a candidate did_id
# list: performance_score (kept current by did_optimizer_hangup.agi on every
# completed call) and last_used are read directly off did_optimizer_pool, no
# scoring math or vicidial_log query happens here. FOR UPDATE SKIP LOCKED lets
# concurrent calls each grab a different row instead of queueing behind a
# single campaign lock; a row already reserved by another in-flight call is
# simply skipped rather than blocked on. Tries excluding $exclude_did_number
# (the campaign's last-used DID) first, then retries allowing it, same
# fallback order as before. Returns (reserved_row, previous_excluded) or ()
# if nothing could be reserved (all eligible rows currently locked, or none
# eligible).
sub reserve_did {
    my ($db, $did_ids, $exclude_did_number) = @_;
    return () unless @$did_ids;
    my $placeholders = join(',', ('?') x scalar(@$did_ids));

    for my $exclude_prev (($exclude_did_number ? (1) : ()), 0) {
        my $sql = qq{
            SELECT did_id, did_number, sample_size, human_answered_calls, good_calls,
                   answered_seconds_sum, performance_score
              FROM did_optimizer_pool
             WHERE did_id IN ($placeholders)
               AND enabled = 'Y'
               AND (daily_limit = 0 OR
                    CASE WHEN usage_date = CURDATE() THEN calls_today ELSE 0 END < daily_limit)
        };
        my @bind = @$did_ids;
        if ($exclude_prev) {
            $sql .= ' AND did_number <> ?';
            push @bind, $exclude_did_number;
        }
        $sql .= q{
             ORDER BY performance_score DESC, last_used ASC, did_id ASC
             LIMIT 1
             FOR UPDATE SKIP LOCKED
        };
        my $row = $db->selectrow_hashref($sql, undef, @bind);
        next unless $row;

        my $updated = $db->do(q{
            UPDATE did_optimizer_pool
               SET calls_today = IF(usage_date = CURDATE(), calls_today + 1, 1),
                   usage_date = CURDATE(),
                   total_assignments = total_assignments + 1,
                   last_used = NOW()
             WHERE did_id = ?
               AND enabled = 'Y'
               AND (daily_limit = 0 OR
                    CASE WHEN usage_date = CURDATE() THEN calls_today ELSE 0 END < daily_limit)
        }, undef, $row->{'did_id'});
        return ($row, $exclude_prev) if $updated;
    }
    return ();
}

sub select_and_record {
    my ($db, $call) = @_;
    my $campaign = $call->{'campaign_id'};

    my $candidates = get_candidate_dids($db, $campaign);
    abort_request('NO_DID', 'No enabled DID remains below its daily limit') unless @$candidates;
    my @candidate_numbers = map { $_->{'did_number'} } @$candidates;
    my $geo_profiles = get_geo_profiles($db, [$call->{'destination'}, @candidate_numbers]);
    my $destination_npanxx = get_npanxx($call->{'destination'});
    my $destination_profile = $geo_profiles->{$destination_npanxx};
    my ($geo_pool, $best_geo_rank) = get_best_geo_pool($candidates, $destination_profile, $geo_profiles);

    for my $candidate (@$candidates) {
        agi_verbose(
            sprintf(
                'candidate DID=%s npanxx=%s geo_rank=%d sample=%d human=%d good=%d avg_answered=%.1f score=%.4f',
                $candidate->{'did_number'}, $candidate->{'npanxx'} || 'NONE',
                $candidate->{'geo_match_rank'} || 0,
                $candidate->{'sample_size'} || 0,
                $candidate->{'human_answered_calls'} || 0,
                $candidate->{'good_calls'} || 0,
                $candidate->{'human_answered_calls'}
                    ? $candidate->{'answered_seconds_sum'} / $candidate->{'human_answered_calls'} : 0,
                $candidate->{'performance_score'} || 0
            ),
            0
        );
    }

    for (my $attempt = 1; ; $attempt++) {
        my @result = eval {
            select_and_record_txn($db, $campaign, $call, $candidates, $geo_pool, $best_geo_rank)
        };
        return @result if !$@;

        my $error = $@;
        my $errno = $db->err;
        eval { $db->rollback() unless $db->{'AutoCommit'}; };
        die $error
            unless $errno && ($errno == 1213 || $errno == 1205) && $attempt < $DEADLOCK_MAX_ATTEMPTS;
        agi_verbose("retrying campaign=$campaign after MySQL error $errno (attempt $attempt)", 1);
        select(undef, undef, undef, 0.05 * $attempt);
    }
}

sub select_and_record_txn {
    my ($db, $campaign, $call, $candidates, $geo_pool, $best_geo_rank) = @_;

    # Idempotency: a repeated AGI execution for the same call reuses its first
    # committed DID and never increments counters twice. No lock needed here -
    # unique_call_id is unique-keyed, so a concurrent duplicate insert fails
    # on that constraint instead of racing past this check.
    my $existing = $db->selectrow_hashref(
        q{SELECT assignment_id, did_number
          FROM did_optimizer_assignments
          WHERE unique_call_id = ?},
        undef, $call->{'unique_call_id'}
    );
    if ($existing) {
        return ({
            did_id => undef,
            did_number => $existing->{'did_number'},
            npanxx => get_npanxx($existing->{'did_number'}),
        }, {
            sample_size => 0, human_answered_calls => 0, good_calls => 0,
            average_answered_duration => 0, performance_score => 0,
        }, {
            reason => 'IDEMPOTENT_REUSE', used_local_pool => 0,
            previous_excluded => 0, candidate_count => 1, geo_match_rank => 0,
        }, $existing->{'assignment_id'});
    }

    # Plain read, not FOR UPDATE: the anti-repeat exclusion below is
    # best-effort under heavy concurrency (two simultaneous calls can in rare
    # cases both avoid a stale previous_did rather than each other's pick),
    # traded for not serializing every call in a campaign behind one row lock.
    my ($previous_did) = $db->selectrow_array(
        q{SELECT last_did FROM did_optimizer_campaign_state WHERE campaign_id = ?},
        undef, $campaign
    );

    $db->begin_work();

    my @geo_ids = map { $_->{'did_id'} } @$geo_pool;
    my @all_ids = map { $_->{'did_id'} } @$candidates;

    my ($reserved, $previous_excluded) = reserve_did($db, \@geo_ids, $previous_did);
    my $used_local_pool = $best_geo_rank ? 1 : 0;
    unless ($reserved) {
        ($reserved, $previous_excluded) = reserve_did($db, \@all_ids, $previous_did);
        $used_local_pool = 0;
    }
    unless ($reserved) {
        $db->rollback();
        abort_request('NO_DID', 'No DID could be reserved (all eligible rows locked or ineligible)');
    }

    my $reason = $used_local_pool ? 'HIGH_SCORE_LOCAL_LRU' : 'HIGH_SCORE_CAMPAIGN_LRU';
    my $insert = $db->prepare(q{
        INSERT INTO did_optimizer_assignments
            (unique_call_id, campaign_id, server_ip, lead_id, auto_call_id, did_number,
             destination, selection_reason)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    });
    $insert->execute(
        $call->{'unique_call_id'}, $campaign, $call->{'server_ip'}, $call->{'lead_id'},
        $call->{'auto_call_id'}, $reserved->{'did_number'},
        $call->{'destination'}, $reason
    );
    my $assignment_id = $db->{'mysql_insertid'};

    $db->do(q{INSERT IGNORE INTO did_optimizer_campaign_state (campaign_id) VALUES (?)}, undef, $campaign);
    $db->do(q{
        UPDATE did_optimizer_campaign_state
           SET last_did = ?, updated_at = CURRENT_TIMESTAMP
         WHERE campaign_id = ?
    }, undef, $reserved->{'did_number'}, $campaign);

    $db->commit();

    my $human = $reserved->{'human_answered_calls'} || 0;
    my $metrics = {
        sample_size               => $reserved->{'sample_size'} || 0,
        human_answered_calls      => $human,
        good_calls                => $reserved->{'good_calls'} || 0,
        average_answered_duration => $human ? ($reserved->{'answered_seconds_sum'} || 0) / $human : 0,
        performance_score         => $reserved->{'performance_score'} || 0,
    };
    my $decision = {
        reason => $reason, used_local_pool => $used_local_pool,
        previous_excluded => $previous_excluded, candidate_count => scalar(@$candidates),
        geo_match_rank => $best_geo_rank,
    };
    return ($reserved, $metrics, $decision, $assignment_id);
}

sub publish_success_variables {
    my ($call, $selected, $metrics, $decision, $destination_npanxx) = @_;
    agi_set_variable('DIDOPT_STATUS', 'OK');
    agi_set_variable('DIDOPT_SELECTED', $selected->{'did_number'});
    agi_set_variable('DIDOPT_CAMPAIGN', $call->{'campaign_id'});
    agi_set_variable('DIDOPT_SERVER_IP', $call->{'server_ip'});
    agi_set_variable('DIDOPT_SCORE', sprintf('%.4f', $metrics->{'performance_score'} || 0));
    agi_set_variable('DIDOPT_GOOD_CALLS', $metrics->{'good_calls'} || 0);
    agi_set_variable('DIDOPT_SAMPLE_SIZE', $metrics->{'sample_size'} || 0);
    agi_set_variable('DIDOPT_LOCAL_MATCH', $decision->{'used_local_pool'} ? $destination_npanxx : '');
    agi_set_variable('DIDOPT_GEO_RANK', $decision->{'geo_match_rank'} || 0);
    agi_set_variable('DIDOPT_REASON', $decision->{'reason'});
}

sub main {
    my $agi = read_agi_environment();
    my @args = @ARGV;

    my $config = load_vicidial_config($CONFIG_FILE);
    abort_request('NO_SERVER', "Missing VARserver_ip in $CONFIG_FILE")
        unless defined $config->{'VARserver_ip'} && $config->{'VARserver_ip'} ne '';
    $dbh = connect_database($config);
    die 'Database connection returned no handle' unless $dbh;

    my $call = find_current_call($dbh, $agi, \@args, $config->{'VARserver_ip'});
    validate_call_context($call);
    my $destination_npanxx = get_npanxx($call->{'destination'});

    agi_verbose(
        "server=$call->{'server_ip'} campaign=$call->{'campaign_id'} destination=$call->{'destination'} "
        . "uniqueid=$call->{'unique_call_id'} source=$call->{'lookup_source'}",
        0
    );
    agi_verbose("destination_npanxx=" . ($destination_npanxx || 'NONE'), 0);

    my ($selected, $metrics, $decision, $assignment_id) =
        select_and_record($dbh, $call);

    agi_verbose(
        sprintf(
            'selected DID=%s sample=%d human=%d good=%d score=%.4f avg_answered=%.1f reason=%s',
            $selected->{'did_number'}, $metrics->{'sample_size'} || 0,
            $metrics->{'human_answered_calls'} || 0, $metrics->{'good_calls'} || 0,
            $metrics->{'performance_score'} || 0,
            $metrics->{'average_answered_duration'} || 0,
            $decision->{'reason'}
        ),
        0
    );
    agi_verbose(
        'selection local_pool=' . ($decision->{'used_local_pool'} ? 'Y' : 'N')
        . ' geo_rank=' . ($decision->{'geo_match_rank'} || 0)
        . ' previous_excluded=' . ($decision->{'previous_excluded'} ? 'Y' : 'N')
        . ' candidates=' . ($decision->{'candidate_count'} || 0),
        0
    );

    # Caller ID changes only after COMMIT. A channel mutation cannot be rolled
    # back, while the committed assignment must remain the source of truth.
    die 'Asterisk rejected CALLERID(num) update'
        unless set_callerid($selected->{'did_number'});

    if ($assignment_id) {
        my $marked = eval {
            $dbh->do(
                q{UPDATE did_optimizer_assignments SET callerid_applied = 'Y'
                  WHERE assignment_id = ?},
                undef, $assignment_id
            );
            1;
        };
        # Caller ID is already active and cannot be rolled back. Treat this
        # audit-marker update as best effort; an unmarked assignment is safely
        # excluded from future performance samples.
        agi_verbose('warning: callerid applied but audit marker update failed', 1)
            unless $marked;
    }

    publish_success_variables($call, $selected, $metrics, $decision, $destination_npanxx);
    agi_verbose("callerid committed DID=$selected->{'did_number'}", 0);
    $dbh->disconnect();
    $dbh = undef;
    return 1;
}

my $ok = eval { main(); 1 };
if (!$ok) {
    my $error = $@ || 'Unknown error';
    eval {
        $dbh->rollback() if $dbh && !$dbh->{'AutoCommit'};
    };

    my ($status, $message) = ('ERROR', $error);
    if ($error =~ /^DIDOPT_ABORT\|([^|]+)\|(.*?)(?:\n|$)/s) {
        ($status, $message) = ($1, $2);
    }
    elsif ($error =~ /DBI|database|SQL|prepare|execute|connect/i) {
        $status = 'DB_ERROR';
    }
    $message =~ s/[\r\n]+/ /g;
    $message =~ s/\s+at\s+\S+\s+line\s+\d+.*$//;
    $message = substr($message, 0, 180);
    set_failure_status($status, $message);

    eval { $dbh->disconnect() if $dbh; };
    $dbh = undef;
}

# Always exit cleanly. Failures leave the pre-existing caller ID untouched and
# allow the dialplan to continue to its normal Dial() application.
exit 0;
